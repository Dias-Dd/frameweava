+
+// ============================================================================
+// External GPU Resource Registry & Zero-Readback Interop Bridge
+// ============================================================================
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub enum ExternalGpuPixelFormat {
+    Bgra8Unorm,
+    Rgba16Float,
+}
+
+#[derive(Clone, Debug)]
+pub struct ExternalGpuImageDescriptor {
+    pub name: String,
+    pub external_id: u64,
+    pub d3d11_share_handle: usize,
+    pub width: u32,
+    pub height: u32,
+    pub format: ExternalGpuPixelFormat,
+    pub is_opaque: bool,
+    pub flip_y: bool,
+    pub generation: u64,
+}
+
+#[derive(Clone, Debug, Default, Serialize, Deserialize)]
+pub struct ExternalGpuLockEvent {
+    pub painter_id_raw: u32,
+    pub external_id: u64,
+    pub share_handle: usize,
+    pub gl_texture_id: u32,
+    pub width: u32,
+    pub height: u32,
+    pub lock_us: f64,
+    pub imported_new_pbuffer: bool,
+}
+
+#[derive(Clone, Debug, Default, Serialize, Deserialize)]
+pub struct ExternalGpuTelemetrySnapshot {
+    pub image_cache_gpu_hits: u64,
+    pub image_cache_cpu_bytes: u64,
+    pub lock_call_count: u64,
+    pub unlock_call_count: u64,
+    pub release_call_count: u64,
+    pub total_lock_us: f64,
+    pub total_unlock_us: f64,
+    pub last_lock_us: f64,
+    pub last_unlock_us: f64,
+    pub last_wr_update_us: f64,
+    pub last_wr_render_us: f64,
+    pub display_list_received_count: u64,
+    pub last_locked_gl_textures: Vec<ExternalGpuLockEvent>,
+}
+
+/// Trait implemented by the embedder's ANGLE/D3D11 backend to import shared D3D11
+/// textures into the active WebRender GL context during `ExternalImageHandler::lock`
+/// and release them during `unlock` / `release`.
+pub trait ExternalGpuTextureImporter: Send + Sync {
+    /// Returns `(gl_texture_id, imported_new_pbuffer)`.
+    fn lock_external_gpu_texture(
+        &self,
+        painter_id: PainterId,
+        desc: &ExternalGpuImageDescriptor,
+    ) -> (u32, bool);
+
+    fn unlock_external_gpu_texture(&self, painter_id: PainterId, external_id: u64);
+
+    fn release_external_gpu_texture(&self, painter_id: PainterId, external_id: u64);
+}
+
+#[derive(Clone, Debug)]
+struct BoundWebRenderKeyEntry {
+    external_id: u64,
+    painter_id: PainterId,
+    image_key: ImageKey,
+    descriptor: ImageDescriptor,
+    dirty: bool,
+}
+
+#[derive(Default)]
+struct ExternalGpuRegistryInner {
+    next_id_offset: u64,
+    next_wr_resource_id: u32,
+    by_name: HashMap<String, u64>,
+    by_id: FxHashMap<u64, ExternalGpuImageDescriptor>,
+    bindings: Vec<BoundWebRenderKeyEntry>,
+    pending_deletions: Vec<(PainterId, ImageKey, u64)>,
+    telemetry: ExternalGpuTelemetrySnapshot,
+    native_frames: FxHashMap<PainterId, NativeFrameProgress>,
+    importer: Option<Arc<dyn ExternalGpuTextureImporter>>,
+}
+
+static EXTERNAL_GPU_REGISTRY: std::sync::LazyLock<RwLock<ExternalGpuRegistryInner>> =
+    std::sync::LazyLock::new(|| RwLock::new(ExternalGpuRegistryInner::default()));
+
+pub fn set_external_gpu_texture_importer(importer: Arc<dyn ExternalGpuTextureImporter>) {
+    EXTERNAL_GPU_REGISTRY.write().importer = Some(importer);
+}
+
+pub fn get_external_gpu_texture_importer() -> Option<Arc<dyn ExternalGpuTextureImporter>> {
+    EXTERNAL_GPU_REGISTRY.read().importer.clone()
+}
+
+/// Parses a `gpu-resource://<name>` URL into its resource name.
+pub fn parse_gpu_resource_name(url_str: &str) -> Option<String> {
+    let rest = url_str.strip_prefix("gpu-resource:")?;
+    let trimmed = rest.trim_start_matches('/');
+    let without_query = trimmed.split(&['?', '#'][..]).next().unwrap_or(trimmed);
+    let clean = without_query.trim_matches('/');
+    if clean.is_empty() {
+        None
+    } else {
+        Some(clean.to_string())
+    }
+}
+
+/// Registers or updates an external GPU texture in the global registry.
+pub fn register_external_gpu_image(
+    name: &str,
+    d3d11_share_handle: usize,
+    width: u32,
+    height: u32,
+    format: ExternalGpuPixelFormat,
+    is_opaque: bool,
+    flip_y: bool,
+) -> u64 {
+    let mut reg = EXTERNAL_GPU_REGISTRY.write();
+    if let Some(&existing_id) = reg.by_name.get(name) {
+        if let Some(desc) = reg.by_id.get_mut(&existing_id) {
+            desc.d3d11_share_handle = d3d11_share_handle;
+            desc.width = width;
+            desc.height = height;
+            desc.format = format;
+            desc.is_opaque = is_opaque;
+            desc.flip_y = flip_y;
+            desc.generation += 1;
+        }
+        for b in reg.bindings.iter_mut() {
+            if b.external_id == existing_id {
+                b.descriptor.size =
+                    webrender_api::units::DeviceIntSize::new(width as i32, height as i32);
+                let mut flags = webrender_api::ImageDescriptorFlags::empty();
+                if is_opaque {
+                    flags |= webrender_api::ImageDescriptorFlags::IS_OPAQUE;
+                }
+                b.descriptor.flags = flags;
+                b.dirty = true;
+            }
+        }
+        return existing_id;
+    }
+
+    reg.next_id_offset += 1;
+    let external_id = EXTERNAL_GPU_ID_TAG | reg.next_id_offset;
+    let desc = ExternalGpuImageDescriptor {
+        name: name.to_string(),
+        external_id,
+        d3d11_share_handle,
+        width,
+        height,
+        format,
+        is_opaque,
+        flip_y,
+        generation: 1,
+    };
+    reg.by_name.insert(name.to_string(), external_id);
+    reg.by_id.insert(external_id, desc);
+    external_id
+}
+
+/// Marks a registered external GPU texture as dirty so WebRender invalidates its Picture Cache
+/// and re-samples the GPU texture on the next frame.
+pub fn mark_external_gpu_image_dirty(name: &str) -> bool {
+    let mut reg = EXTERNAL_GPU_REGISTRY.write();
+    let Some(&external_id) = reg.by_name.get(name) else {
+        return false;
+    };
+    if let Some(desc) = reg.by_id.get_mut(&external_id) {
+        desc.generation += 1;
+    }
+    for b in reg.bindings.iter_mut() {
+        if b.external_id == external_id {
+            b.dirty = true;
+        }
+    }
+    true
+}
+
+/// Unregisters an external GPU texture and schedules WebRender `ImageKey` deletion
+/// and ANGLE Pbuffer/GL texture release.
+pub fn unregister_external_gpu_image(name: &str) -> bool {
+    let mut reg = EXTERNAL_GPU_REGISTRY.write();
+    let Some(external_id) = reg.by_name.remove(name) else {
+        return false;
+    };
+    reg.by_id.remove(&external_id);
+    let old_bindings = std::mem::take(&mut reg.bindings);
+    let mut remaining = Vec::with_capacity(old_bindings.len());
+    for b in old_bindings {
+        if b.external_id == external_id {
+            reg.pending_deletions
+                .push((b.painter_id, b.image_key, external_id));
+        } else {
+            remaining.push(b);
+        }
+    }
+    reg.bindings = remaining;
+    true
+}
+
+pub fn get_external_gpu_image_by_name(name: &str) -> Option<ExternalGpuImageDescriptor> {
+    let reg = EXTERNAL_GPU_REGISTRY.read();
+    let id = *reg.by_name.get(name)?;
+    reg.by_id.get(&id).cloned()
+}
+
+pub fn get_external_gpu_image_by_id(external_id: u64) -> Option<ExternalGpuImageDescriptor> {
+    EXTERNAL_GPU_REGISTRY.read().by_id.get(&external_id).cloned()
+}
+
+pub fn allocate_external_gpu_webrender_image_key(painter_id: PainterId) -> ImageKey {
+    let mut reg = EXTERNAL_GPU_REGISTRY.write();
+    reg.next_wr_resource_id += 1;
+    let resource_id = 0x4000_0000u32 + reg.next_wr_resource_id;
+    ImageKey::new(painter_id.into(), resource_id)
+}
+
+pub fn record_external_gpu_webrender_binding(
+    external_id: u64,
+    painter_id: PainterId,
+    image_key: ImageKey,
+    descriptor: ImageDescriptor,
+) {
+    let mut reg = EXTERNAL_GPU_REGISTRY.write();
+    if let Some(existing) = reg
+        .bindings
+        .iter_mut()
+        .find(|b| b.external_id == external_id && b.painter_id == painter_id && b.image_key == image_key)
+    {
+        existing.descriptor = descriptor;
+        existing.dirty = true;
+        return;
+    }
+    reg.bindings.push(BoundWebRenderKeyEntry {
+        external_id,
+        painter_id,
+        image_key,
+        descriptor,
+        dirty: false,
+    });
+}
+
+pub fn take_dirty_external_gpu_updates(
+    painter_id: PainterId,
+) -> Vec<(ImageKey, ImageDescriptor, ExternalImageData)> {
+    let mut reg = EXTERNAL_GPU_REGISTRY.write();
+    let mut out = Vec::new();
+    for b in reg.bindings.iter_mut() {
+        if b.painter_id == painter_id && b.dirty {
+            b.dirty = false;
+            out.push((
+                b.image_key,
+                b.descriptor,
+                ExternalImageData {
+                    id: ExternalImageId(b.external_id),
+                    channel_index: 0,
+                    image_type: webrender_api::ExternalImageType::TextureHandle(
+                        webrender_api::ImageBufferKind::Texture2D,
+                    ),
+                    normalized_uvs: false,
+                },
+            ));
+        }
+    }
+    out
+}
+
+pub fn take_pending_external_gpu_deletions(painter_id: PainterId) -> Vec<(ImageKey, u64)> {
+    let mut reg = EXTERNAL_GPU_REGISTRY.write();
+    let mut out = Vec::new();
+    let mut keep = Vec::new();
+    for (p_id, img_key, ext_id) in reg.pending_deletions.drain(..) {
+        if p_id == painter_id {
+            out.push((img_key, ext_id));
+        } else {
+            keep.push((p_id, img_key, ext_id));
+        }
+    }
+    reg.pending_deletions = keep;
+    out
+}
+
+pub fn record_image_cache_gpu_hit(cpu_bytes: u64) {
+    let mut reg = EXTERNAL_GPU_REGISTRY.write();
+    reg.telemetry.image_cache_gpu_hits += 1;
+    reg.telemetry.image_cache_cpu_bytes += cpu_bytes;
+}
+
+pub fn record_external_gpu_lock_event(event: ExternalGpuLockEvent) {
+    let mut reg = EXTERNAL_GPU_REGISTRY.write();
+    reg.telemetry.lock_call_count += 1;
+    reg.telemetry.total_lock_us += event.lock_us;
+    reg.telemetry.last_lock_us = event.lock_us;
+    if reg.telemetry.last_locked_gl_textures.len() >= 16 {
+        reg.telemetry.last_locked_gl_textures.remove(0);
+    }
+    reg.telemetry.last_locked_gl_textures.push(event);
+}
+
+pub fn record_external_gpu_unlock_event(unlock_us: f64) {
+    let mut reg = EXTERNAL_GPU_REGISTRY.write();
+    reg.telemetry.unlock_call_count += 1;
+    reg.telemetry.total_unlock_us += unlock_us;
+    reg.telemetry.last_unlock_us = unlock_us;
+}
+
+pub fn record_external_gpu_release_event() {
+    let mut reg = EXTERNAL_GPU_REGISTRY.write();
+    reg.telemetry.release_call_count += 1;
+}
+
+pub fn record_webrender_render_timing(wr_update_us: f64, wr_render_us: f64) {
+    let mut reg = EXTERNAL_GPU_REGISTRY.write();
+    reg.telemetry.last_wr_update_us = wr_update_us;
+    reg.telemetry.last_wr_render_us = wr_render_us;
+}
+
+pub fn record_display_list_received(painter: PainterId) {
+    let mut reg = EXTERNAL_GPU_REGISTRY.write();
+    reg.telemetry.display_list_received_count += 1;
+    reg.native_frames.entry(painter).or_default().display_lists += 1;
+}
+
+pub fn get_external_gpu_telemetry_snapshot() -> ExternalGpuTelemetrySnapshot {
+    EXTERNAL_GPU_REGISTRY.read().telemetry.clone()
+}
+
+pub fn reset_external_gpu_telemetry() {
+    let mut reg = EXTERNAL_GPU_REGISTRY.write();
+    reg.telemetry = ExternalGpuTelemetrySnapshot::default();
+}
+
+
+/// Control-plane completion epochs only; never pixel validation or GPU readback.
+#[derive(Clone, Copy, Debug, Default, Serialize)]
+pub struct NativeFrameProgress { pub submitted: u64, pub ready: u64, pub display_lists: u64, pub external_updates: u64 }
+pub fn native_frame_progress(painter: PainterId) -> NativeFrameProgress { EXTERNAL_GPU_REGISTRY.read().native_frames.get(&painter).copied().unwrap_or_default() }
+pub fn record_native_frame_submitted(painter: PainterId) { EXTERNAL_GPU_REGISTRY.write().native_frames.entry(painter).or_default().submitted += 1; }
+pub fn record_native_frame_ready(painter: PainterId) { EXTERNAL_GPU_REGISTRY.write().native_frames.entry(painter).or_default().ready += 1; }
+pub fn record_native_external_update(painter: PainterId) { EXTERNAL_GPU_REGISTRY.write().native_frames.entry(painter).or_default().external_updates += 1; }
+pub fn forget_native_frame_progress(painter: PainterId) { EXTERNAL_GPU_REGISTRY.write().native_frames.remove(&painter); }
