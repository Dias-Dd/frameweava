+            share_handle: desc.d3d11_share_handle,
+            gl_texture_id,
+            width: desc.width,
+            height: desc.height,
+            lock_us,
+            imported_new_pbuffer,
+        });
+        (
+            paint_api::ExternalImageSource::NativeTexture(gl_texture_id),
+            euclid::default::Size2D::new(desc.width as i32, desc.height as i32),
+        )
+    }
+
+    fn unlock(&mut self, id: u64) {
+        let t0 = std::time::Instant::now();
+        if let Some(importer) = paint_api::get_external_gpu_texture_importer() {
+            importer.unlock_external_gpu_texture(self.painter_id, id);
+        }
+        let unlock_us = t0.elapsed().as_secs_f64() * 1_000_000.0;
+        paint_api::record_external_gpu_unlock_event(unlock_us);
+    }
+}
