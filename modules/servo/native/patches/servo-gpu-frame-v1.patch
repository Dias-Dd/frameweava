+    /// Intercepts `gpu-resource://<name>` URLs and resolves them directly from
+    /// `paint_api`'s `ExternalGpuImageRegistry` as WebRender `ExternalImageData`
+    /// (`TextureHandle(Texture2D)`) with zero CPU pixel allocation or decoding.
+    fn ensure_external_gpu_image_loaded(
+        &mut self,
+        url: &ServoUrl,
+        origin: &ImmutableOrigin,
+        cors_setting: Option<CorsSettings>,
+    ) {
+        let Some(resource_name) = paint_api::parse_gpu_resource_name(url.as_str()) else {
+            return;
+        };
+        let Some(gpu_desc) = paint_api::get_external_gpu_image_by_name(&resource_name) else {
+            warn!("External GPU resource not found in registry for URL: {}", url);
+            return;
+        };
+
+        let cache_key = (url.clone(), origin.clone(), cors_setting);
+        if let Some(existing) = self.completed_loads.get(&cache_key) {
+            if let ImageResponse::Loaded(Image::Raster(ref existing_img), _) =
+                existing.image_response
+            {
+                if existing_img.metadata.width == gpu_desc.width &&
+                    existing_img.metadata.height == gpu_desc.height
+                {
+                    return;
+                }
+                if let Some(image_key) = existing_img.id {
+                    let mut flags = ImageDescriptorFlags::empty();
+                    if gpu_desc.is_opaque {
+                        flags |= ImageDescriptorFlags::IS_OPAQUE;
+                    }
+                    let descriptor = ImageDescriptor {
+                        size: DeviceIntSize::new(gpu_desc.width as i32, gpu_desc.height as i32),
+                        stride: None,
+                        format: WebRenderImageFormat::BGRA8,
+                        offset: 0,
+                        flags,
+                    };
+                    let ext_data = ExternalImageData {
+                        id: ExternalImageId(gpu_desc.external_id),
+                        channel_index: 0,
+                        image_type: ExternalImageType::TextureHandle(ImageBufferKind::Texture2D),
+                        normalized_uvs: false,
+                    };
+                    self.paint_api.update_image(
+                        image_key,
+                        descriptor,
+                        SerializableImageData::External(ext_data),
+                        None,
+                    );
+                    paint_api::record_external_gpu_webrender_binding(
+                        gpu_desc.external_id,
+                        self.webview_id.into(),
+                        image_key,
+                        descriptor,
+                    );
+                    let raster_image = RasterImage {
+                        metadata: ImageMetadata {
+                            width: gpu_desc.width,
+                            height: gpu_desc.height,
+                        },
+                        format: PixelFormat::BGRA8,
+                        frames: vec![ImageFrame {
+                            delay: None,
+                            byte_range: 0..0,
+                            width: gpu_desc.width,
+                            height: gpu_desc.height,
+                        }],
+                        bytes: Arc::new(Vec::new()),
+                        id: Some(image_key),
+                        cors_status: CorsStatus::Safe,
+                        is_opaque: gpu_desc.is_opaque,
+                        loop_count: None,
+                    };
+                    let image_response =
+                        ImageResponse::Loaded(Image::Raster(Arc::new(raster_image)), url.clone());
+                    let load_key = existing.id;
+                    self.completed_loads
+                        .insert(cache_key, CompletedLoad::new(image_response, load_key));
+                    return;
+                }
+            }
+        }
+
+        let image_key =
+            paint_api::allocate_external_gpu_webrender_image_key(self.webview_id.into());
+        let mut flags = ImageDescriptorFlags::empty();
+        if gpu_desc.is_opaque {
+            flags |= ImageDescriptorFlags::IS_OPAQUE;
+        }
+        let descriptor = ImageDescriptor {
+            size: DeviceIntSize::new(gpu_desc.width as i32, gpu_desc.height as i32),
+            stride: None,
+            format: WebRenderImageFormat::BGRA8,
+            offset: 0,
+            flags,
+        };
+        let ext_data = ExternalImageData {
+            id: ExternalImageId(gpu_desc.external_id),
+            channel_index: 0,
+            image_type: ExternalImageType::TextureHandle(ImageBufferKind::Texture2D),
+            normalized_uvs: false,
+        };
+        self.paint_api.add_image(
+            image_key,
+            descriptor,
+            SerializableImageData::External(ext_data),
+            false,
+        );
+        paint_api::record_external_gpu_webrender_binding(
+            gpu_desc.external_id,
+            self.webview_id.into(),
+            image_key,
+            descriptor,
+        );
+        paint_api::record_image_cache_gpu_hit(0);
+
+        let raster_image = RasterImage {
+            metadata: ImageMetadata {
+                width: gpu_desc.width,
+                height: gpu_desc.height,
+            },
+            format: PixelFormat::BGRA8,
+            frames: vec![ImageFrame {
+                delay: None,
+                byte_range: 0..0,
+                width: gpu_desc.width,
+                height: gpu_desc.height,
+            }],
+            bytes: Arc::new(Vec::new()),
+            id: Some(image_key),
+            cors_status: CorsStatus::Safe,
+            is_opaque: gpu_desc.is_opaque,
+            loop_count: None,
+        };
+        let image_response =
+            ImageResponse::Loaded(Image::Raster(Arc::new(raster_image)), url.clone());
