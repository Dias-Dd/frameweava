{
  "status": "candidate API resource, not a new discovery protocol",
  "package": "spatial-liquid-candidate@0.1.5",
  "declaration": "api.d.ts",
  "defaults": {
    "material": {
      "density": 1000,
      "spacing": 0.12,
      "support": 0.24,
      "iterations": 4,
      "relaxation": 1e-06,
      "viscosity": 0.03,
      "vorticity": 0,
      "surfaceTension": 0
    },
    "substeps": 2,
    "dimensions": [
      48,
      48,
      32
    ],
    "format": "rgba32float",
    "isoDensity": 0.5,
    "stepScale": 0.65,
    "maxBytes": 268435456,
    "maxWork": 100000000000,
    "maxSamples": 1000000000
  },
  "time": "Original Core FrameContext, Signal, seededRandom, FixedStepRunner and NativeReplay/flushState",
  "dependencies": [
    "original Native GPU owner/recorder",
    "Three0.186.1 camera math",
    "PBD2.2.0 MIT selected math",
    "SPlisHSPlasH pinned MIT selected math"
  ],
  "functions": [
    {
      "name": "liquidScene",
      "purpose": "Complete Native PBF liquid shot",
      "input": "CreationInit, LiquidSceneOptions",
      "output": "CreationStage with owned linear PM F16/F32 images",
      "parameters": "TypeScript api.d.ts is authoritative",
      "example": "liquid.tsx",
      "limitations": "LIQUID.md"
    },
    {
      "name": "createLiquidSimulation",
      "purpose": "Retained resident GPU liquid state",
      "input": "CreationInit, LiquidOptions",
      "output": "record(FrameContext) -> borrowed LiquidFrame",
      "parameters": "TypeScript api.d.ts is authoritative",
      "example": "liquid.tsx",
      "limitations": "LIQUID.md"
    },
    {
      "name": "reconstructLiquidField",
      "purpose": "Actual 3D SPH density reconstruction",
