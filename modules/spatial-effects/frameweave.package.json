  "compatible": "0.1.0",
  "platforms": ["web"],
  "capabilities": [],
  "permissions": {"filesystem":false,"network":false,"process":false},
  "entry": "main",
  "modules": {
    "main":{"format":"javascript","path":"./src/index.ts"},
    "bindings":{"format":"javascript","path":"./src/bindings.ts"}
  },
  "bindings":{"schemaVersion":1,"module":"bindings","types":"./dist/index.d.ts","initialize":"initialize","engine":"web","gpu":"required","gpuApi":"webgl2","gpuExports":["createParticleRenderer","createNoiseTextureRenderer"]}
