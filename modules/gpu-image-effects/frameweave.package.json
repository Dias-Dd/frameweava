{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "gpu-image-effects",
  "version": "0.6.0",
  "name": "Professional GPU Image Effects",
  "description": "23 Stage-local hardware GPU image effects over professional floating surfaces, including coverage complement/replacement/difference, RGB modulation/offset and compensated Over/Screen/Multiply. Crossfade with explicit HDR/PM semantics. Strict data-dependent precision and native PM blend output; no CPU or SDR fallback.",
