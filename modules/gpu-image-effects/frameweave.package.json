  "source": {"kind": "local", "authority": "frameweave.gpu-images"},
  "compatible": "0.1.0",
  "platforms": ["web"],
  "capabilities": ["webgpu"],
  "permissions": {"filesystem": false, "network": false, "process": false},
  "modules": {"main": {"format": "javascript", "path": "./public.ts"}, "bindings": {"format": "javascript", "path": "./bindings.ts"}},
  "bindings": {"schemaVersion": 1, "module": "bindings", "types": "./api.d.ts", "initialize": "initialize", "engine": "web", "gpu": "required"}
}
