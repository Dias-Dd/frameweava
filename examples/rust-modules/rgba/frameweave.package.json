{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "kit.rgba",
  "version": "1.0.0",
  "name": "kit.rgba",
  "description": "Rust RGBA channel transform fixture for module resource and export validation",
  "source": {
    "kind": "local",
    "authority": "frameweave.examples"
  },
  "compatible": "^0.1.0",
  "platforms": [
    "web"
  ],
  "capabilities": [
    "wasm",
    "canvas2d"
  ],
  "permissions": {
    "filesystem": false,
    "network": false,
    "process": false
  },
  "entry": "main",
  "effect": "./effect.json",
  "modules": {
    "main": {
      "format": "javascript",
      "path": "./index.ts"
    },
    "glue": {
      "format": "javascript",
      "path": "./runtime/session.mjs"
    },
    "core": {
      "format": "wasm",
      "path": "./dist/module.wasm",
      "abi": "core-v1",
      "producer": "rust"
    },
    "bytes": {
      "format": "resource",
      "path": "./dist/module.wasm"
    },
    "worker": {
      "format": "resource",
      "path": "./dist/worker.js"
    }
  },
  "dependencies": {}
}
