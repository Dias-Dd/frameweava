{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@frameweave/engine",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "noUncheckedIndexedAccess": false,
    "paths": {
      "native-image-effects": [
        "./modules/native-effects/api.d.ts"
      ],
      "spatial-fields": [
        "./modules/spatial-fields/index.ts"
      ],
      "deformable-effects": [
        "./modules/deformable-effects/src/public.d.ts"
      ],
      "mesh-deformation": [
        "./modules/mesh-deformation/index.ts"
      ],
      "puppet-effects": [
        "./modules/puppet-effects/src/public.d.ts"
      ],
      "rigid-body-effects": [
        "./modules/rigid-body-effects/src/public.d.ts"
      ],
      "skeletal-effects": [
        "./modules/skeletal-effects/src/public.d.ts"
      ],
      "spatial-effects": [
        "./modules/spatial-effects/src/index.ts"
      ],
      "spatial-compute": [
        "./modules/spatial-compute/index.ts"
      ],
      "spatial-vfx": [
        "./modules/spatial-vfx/index.ts"
      ],
      "pro-animation": [
        "./modules/pro-animation/src/public.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "examples",
    "scripts",
    "plugins"
  ],
  "exclude": [
    "node_modules",
    ".frameweave",
    "artifacts",
    ".canvix"
  ]
}
